# Live user data. buschain.db is the app's default DB and holds the
# dispatcher's real plan — never commit it, and never point an experiment at
# it (pass a scratch path to create_app instead). The -shm/-wal siblings are
# SQLite's WAL files for the same database.
buschain.db
buschain.db-shm
buschain.db-wal
*.db
*.db-shm
*.db-wal

# LDC_PLANNER__test.xlsx IS tracked — it is the golden fixture the whole suite
# runs against. This one is a post-export copy of it (it already carries the
# Nationality/OP pick-list columns in Information!O and !P, which the fixture
# predates), kept out so it cannot shadow the real file again.
LDC_PLANNER__test-FINAL.xlsx

# Environment and build artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/

# macOS
.DS_Store
